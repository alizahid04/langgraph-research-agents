# Copy this file to .env and fill in your keys.
# BOTH keys are required — there is no mock mode. Without them,
# POST /api/workflows returns a 400 explaining what's missing.

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/anthropic/claude-3.5-sonnet
TAVILY_API_KEY=

DATABASE_URL=sqlite:///./research_platform.db
MAX_REVISIONS=2
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000
